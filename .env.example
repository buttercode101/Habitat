# Habitat evidence service (Python core) — server-side only, never commit real values.
# Start: habitat serve --host 0.0.0.0 --port 8787 --secret-env HABITAT_WEBHOOK_SECRET
HABITAT_WEBHOOK_SECRET=
HABITAT_AGENT_SECRET=
# Web dashboard (web/) — server-only, never NEXT_PUBLIC_*:
# HABITAT_API_URL=https://habitat-api.example.com
# HABITAT_API_TOKEN=
HABITAT_API_URL=
HABITAT_API_TOKEN=
